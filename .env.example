# HUMIS local secrets (not committed).
# Copy this file to `.env` and fill in values. Never commit `.env`.
# Server-only names belong here. Never put secrets in VITE_ variables —
# those are baked into the browser bundle.

# Speech-to-text (ASR v3) and speech (TTS v2). Server only — never put this in client code.
# Get a Khaya AI key at https://translation.ghananlp.org then set:
KHAYA_API_KEY=

# Optional. Phase 8A listens in African English. Leave this as eng.
# Ghanaian-language switching is Phase 8C.
KHAYA_ASR_LANGUAGE=eng

# Optional. Phase 8B speaks African English. Leave this as eng.
KHAYA_TTS_LANGUAGE=eng

# Optional Khaya voice: male_low, male_high, or female. Empty uses Khaya's default.
KHAYA_TTS_SPEAKER=

# Optional farm location for the Open-Meteo weather forecast. Not a secret.
# If unset, AquaFlow uses the location in Settings (default: Kumasi, Ghana).
# FARM_LATITUDE=6.6885
# FARM_LONGITUDE=-1.6244
# FARM_LOCATION_LABEL=Kumasi, Ghana

# --- Real ESP32 board (server only) ---

# Keep the practice farm on until the real board has been tested.
# Only set this to false after the ESP32 is posting live readings.
USE_SIMULATED=true

# Shared secret for the ESP32. PictoBlox cannot sign in as a farmer, so the
# board sends this key instead of a login cookie.
# HUMIS_HARDWARE_KEY=change-me-to-a-long-random-string

# --- HUMIS login (server only — never put these in client code) ---

# Long random secret. If unset, HUMIS makes a temporary one and sessions
# reset when the server restarts. Required on a public host.
# AUTH_SESSION_SECRET=

# Optional. Force the login cookie to HTTPS (true) or allow HTTP (false).
# If unset, HUMIS uses HTTPS when the request is HTTPS (including behind Render).
# AUTH_COOKIE_SECURE=

# Optional bind. Production hosts usually set PORT. Local default is 5418.
# PORT=5418
# HOST=0.0.0.0

# First account, created only when no users exist yet. Optional.
# Prefer creating an account on the Register page.
# AUTH_BOOTSTRAP_EMAIL=farmer@example.com
# AUTH_BOOTSTRAP_PASSWORD=
# AUTH_BOOTSTRAP_NAME=Farm manager
# AUTH_BOOTSTRAP_FARM_NAME=My farm

# Public URL of the HUMIS website, used in password-reset emails.
# APP_PUBLIC_URL=http://127.0.0.1:5417

# Email for password-reset links. If SMTP_HOST is empty, HUMIS does not
# pretend to send mail. In local development the reset link is printed in
# the server log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=HUMIS <noreply@example.com>
