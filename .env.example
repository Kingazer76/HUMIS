# AquaFlow local secrets (not committed)

# Speech-to-text (ASR v3) and speech (TTS v2). Server only — never put this in client code.
# Get a Khaya AI key at https://translation.ghananlp.org then set:
KHAYA_API_KEY=

# Optional. Phase 8A listens in African English. Leave this as eng.
# Ghanaian-language switching is Phase 8C.
KHAYA_ASR_LANGUAGE=eng

# Optional. Phase 8B speaks African English. Leave this as eng.
KHAYA_TTS_LANGUAGE=eng

# Optional Khaya voice: male_low, male_high, or female. Empty uses Khaya's default.
KHAYA_TTS_SPEAKER=

# Optional farm location for the Open-Meteo weather forecast. Not a secret.
# If unset, AquaFlow uses the location in Settings (default: Kumasi, Ghana).
# FARM_LATITUDE=6.6885
# FARM_LONGITUDE=-1.6244
# FARM_LOCATION_LABEL=Kumasi, Ghana
